{
  "manifest_version": 3,
  "name": "Pure Black Neon",
  "version": "2.6.1",
  "description": "Negro #000000 puro en cualquier web: inversión con media intacta o modo AMOLED. Sin analizar el DOM.",
  "author": "Pure Black Neon",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pure-black-neon@buffy.dev",
      "strict_min_version": "155.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "155.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "action": {
    "default_title": "Pure Black Neon — ajustes",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["invert.css", "amoled.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Activar/desactivar Pure Black Neon en la pestaña actual"
    }
  }
}
